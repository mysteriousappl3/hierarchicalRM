<!-- This file contains the description of the dVRK PSM robot with LND tool.-->

<mujoco model="psm_cf">

	<compiler discardvisual="false" angle="radian" meshdir="../meshes/obj/"/>
	<option integrator="implicitfast"/>

	<default>
		<default class="psm_cf">
			<material specular="0.5" shininess="0.25"/>
			<position kp="100" kv="10"/>
			<default class="cf_tool">
				<position kp="10" kv="1"/>
			</default>
			<default class="visual">
				<geom type="mesh" contype="0" conaffinity="0" group="2"/>
			</default>
			<default class="collision">
				<geom type="mesh" group="3"/>
			</default>
		</default>
	</default>

	<asset>
		<material class="psm_cf" name="white" rgba="1 1 1 1"/>
		<material class="psm_cf" name="off_white" rgba="0.89804 0.91765 0.92941 1"/>
		<material class="psm_cf" name="black" rgba="0.3 0.3 0.3 1"/>
		<material class="psm_cf" name="silver" rgba="0.79608 0.82353 0.93725 1"/>

		<!-- Collision meshes -->
		<mesh name="lnd_roll_link_collision_0" file="lnd_roll_link_collision_0.obj"/>
		<mesh name="lnd_roll_link_collision_1" file="lnd_roll_link_collision_1.obj"/>
		<mesh name="lnd_roll_link_collision_2" file="lnd_roll_link_collision_2.obj"/>
		<mesh name="lnd_pitch_link_collision_0" file="lnd_pitch_link_collision_0.obj"/>
		<mesh name="lnd_pitch_link_collision_1" file="lnd_pitch_link_collision_1.obj"/>
		<mesh name="lnd_pitch_link_collision_2" file="lnd_pitch_link_collision_2.obj"/>
		<mesh name="cf_gripper_link_collision_0" file="cf_gripper_link_collision_0.obj"/>
		<mesh name="cf_gripper_link_collision_1" file="cf_gripper_link_collision_1.obj"/>
		<mesh name="cf_gripper_link_collision_2" file="cf_gripper_link_collision_2.obj"/>
		<mesh name="cf_gripper_link_collision_3" file="cf_gripper_link_collision_3.obj"/>
		<mesh name="cf_gripper_link_collision_4" file="cf_gripper_link_collision_4.obj"/>
		<!-- <mesh name="cf_gripper_link_collision_5" file="cf_gripper_link_collision_5.obj"/> -->
		<mesh name="tool_main_insertion_link_collision_0" file="tool_main_insertion_link_collision_0.obj"/>
		<mesh name="tool_main_insertion_link_collision_1" file="tool_main_insertion_link_collision_1.obj"/>

		<!-- Visual meshes -->
		<mesh name="base_link" file="base_link.obj"/>
		<mesh name="yaw_link" file="yaw_link.obj"/>
		<mesh name="pitch_back_link" file="pitch_back_link.obj"/>
		<mesh name="pitch_bottom_link" file="pitch_bottom_link.obj"/>
		<mesh name="pitch_end_link" file="pitch_end_link.obj"/>
		<mesh name="pitch_top_link" file="pitch_top_link.obj"/>
		<mesh name="pitch_front_link" file="pitch_front_link.obj"/>
		<mesh name="tool_main_insertion_link" file="tool_main_insertion_link.obj"/>
		<mesh name="lnd_roll_link" file="lnd_roll_link.obj"/>
		<mesh name="lnd_pitch_link" file="lnd_pitch_link.obj"/>
		<mesh name="lnd_yaw_link" file="lnd_yaw_link.obj"/>
		<mesh name="cf_gripper_link" file="cf_gripper_link.obj"/>

	</asset>

	<worldbody>
		<light name="top" pos="0 0 2" mode="trackcom"/>
		<geom mesh="base_link" pos="0 0 0.1524" class="visual" material="off_white"/>

		<body name="yaw_link" childclass="psm_cf" pos="0 0.4864 0.1524" quat="0.5 0.5 -0.5 0.5">
			<inertial pos="-0.038769 0 0.041596" quat="0.999476 -0.0323563 -0.000353998 0.000808658"
				mass="1.4705" diaginertia="0.0181432 0.015746 0.0082178"/>
			<joint name="outer_yaw" range="-1.605 1.5994"/>
			<geom mesh="yaw_link" pos="0 0 0.4864" class="visual" material="off_white"/>

			<body name="pitch_back_link" pos="0 0 0.516" quat="0.699649 -0.699649 -0.102427 -0.102427">
				<inertial pos="-0.011651 -0.036241 0" quat="0.526057 0.535871 0.461387 0.47247"
					mass="0.98494" diaginertia="0.00571089 0.00564713 0.00196294"/>
				<joint name="outer_pitch" range="-0.93556 0.94249"/>
				<geom mesh="pitch_back_link" class="visual" material="off_white"/>

				<body name="pitch_bottom_link" pos="0.15 0 0" quat="0.597233 0 0 0.802068">
					<inertial pos="0.25683 -0.010348 0" quat="0.493171 0.49203 0.507846 0.506736"
						mass="0.44569" diaginertia="0.0112804 0.0111024 0.000450444"/>
					<joint name="pitch_bottom_joint" range="-0.94249 0.93556"/>
					<geom mesh="pitch_bottom_link" class="visual" material="off_white"/>

					<body name="pitch_end_link" pos="0.516 0 0">
						<inertial pos="-0.0019293 -0.13613 0" quat="0.707004 0.707004 -0.0120644 -0.0120619"
						mass="0.355" diaginertia="0.0238961 0.0238961 0.0238961"/>
						<joint name="pitch_end_joint" range="-0.93556 0.94249"/>
						<geom mesh="pitch_end_link" class="visual" material="off_white"/>

						<body name="main_insertion_link" pos="0.043 -0.28809 0" quat="0.5 -0.499999 0.500001 0.499999">
							<inertial pos="0.0040563 -0.00010934 0.0098616" quat="0.923879 0.382683 -0.00072506 -0.00030033"
								mass="0.22491" diaginertia="0.004 0.004 0.004"/>
							<joint name="main_insertion" type="slide" range="0 0.24"/>
							<geom mesh="tool_main_insertion_link" quat="0.707105 0 0 0.707108" class="visual" material="black"/>
							<geom mesh="tool_main_insertion_link_collision_0" quat="0.707105 0 0 0.707108" class="collision"/>
							<geom mesh="tool_main_insertion_link_collision_1" quat="0.707105 0 0 0.707108" class="collision"/>

							<body name="tool_roll_link" pos="0 0 0.4162" quat="0.707105 0 0 -0.707108">
								<inertial pos="0 0 -0.0058234" quat="0.820473 0.339851 -0.17592 0.424708"
									mass="0.00033225" diaginertia="0.00102 0.00099 0.00099"/>
								<joint name="tool_roll" range="-3.14159 3.14159"/>
								<geom mesh="lnd_roll_link" class="visual" material="silver"/>
								<geom mesh="lnd_roll_link_collision_0" class="collision"/>
								<geom mesh="lnd_roll_link_collision_1" class="collision"/>
								<geom mesh="lnd_roll_link_collision_2" class="collision"/>

								<body name="tool_pitch_link" quat="0.499998 0.5 -0.5 0.500002">
									<inertial pos="0.0035763 0 0" quat="0.820473 0.339851 -0.17592 0.424708"
										mass="0.00025784" diaginertia="0.00102 0.00099 0.00099"/>
									<joint name="tool_pitch" range="-1.5708 1.5708"/>
									<geom mesh="lnd_pitch_link" class="visual" material="silver"/>
									<geom mesh="lnd_pitch_link_collision_0" class="collision"/>
									<geom mesh="lnd_pitch_link_collision_1" class="collision"/>
									<geom mesh="lnd_pitch_link_collision_2" class="collision"/>

									<body name="tool_yaw_link" pos="0.0091 0 0" quat="0.499998 -0.5 0.5 0.500002">
										<inertial pos="0 0 0" quat="0.820473 0.339851 -0.17592 0.424708"
											mass="0.012491" diaginertia="0.00102 0.00099 0.00099"/>
										<joint name="tool_yaw" range="-1.5708 1.5708"/>
										<geom mesh="lnd_yaw_link" class="visual" material="silver"/>

										<body name="tool_gripper1_link">
											<inertial pos="0.00019605 0.001435 -0.00088478" quat="0.820473 0.339851 -0.17592 0.424708"
												mass="0.010491" diaginertia="0.00102 0.00099 0.00099"/>
											<joint name="tool_gripper1_joint" range="-0.523599 0"/>
											<geom mesh="cf_gripper_link" quat="-3.67321e-06 0 1 0" class="visual" material="silver"/>
											<geom mesh="cf_gripper_link_collision_0" quat="-3.67321e-06 0 1 0" class="collision"/>
											<geom mesh="cf_gripper_link_collision_1" quat="-3.67321e-06 0 1 0" class="collision"/>
											<geom mesh="cf_gripper_link_collision_2" quat="-3.67321e-06 0 1 0" class="collision"/>
											<geom mesh="cf_gripper_link_collision_3" quat="-3.67321e-06 0 1 0" class="collision"/>
											<geom mesh="cf_gripper_link_collision_4" quat="-3.67321e-06 0 1 0" class="collision"/>
											<!-- <geom mesh="cf_gripper_link_collision_5" class="collision"/> -->
										</body>
										<body name="tool_gripper2_link">
											<inertial pos="-0.00019605 0.001435 0.00088478" quat="0.820473 0.339851 -0.17592 0.424708"
												mass="0.010491" diaginertia="0.00102 0.00099 0.00099"/>
											<joint name="jaw" range="0 0.523599"/>
											<geom mesh="cf_gripper_link" class="visual" material="silver"/>
											<geom mesh="cf_gripper_link_collision_0" class="collision"/>
											<geom mesh="cf_gripper_link_collision_1" class="collision"/>
											<geom mesh="cf_gripper_link_collision_2" class="collision"/>
											<geom mesh="cf_gripper_link_collision_3" class="collision"/>
											<geom mesh="cf_gripper_link_collision_4" class="collision"/>
											<!-- <geom mesh="cf_gripper_link_collision_5" quat="-3.67321e-06 0 1 0" class="collision"/> -->
										</body>
									</body>
								</body>
							</body>
						</body>
					</body>
				</body>

				<!-- Mimic Links -->
				<body name="pitch_top_link" pos="0.18366 0.014121 0" quat="0.597233 0 0 0.802068">
					<inertial pos="0.31246 -0.00056566 0" quat="0.500628 0.500628 0.499371 0.499371" mass="0.17841" diaginertia="0.00463463 0.00449516 0.000149862"/>
					<joint name="pitch_top_joint" range="-0.94249 0.93556"/>
					<geom mesh="pitch_top_link" class="visual" material="off_white"/>
				</body>
			</body>
			<body name="pitch_front_link" pos="0 0 0.42" quat="0.699649 -0.699649 -0.102427 -0.102427">
				<inertial pos="0.096269 0 0.047551" quat="0.519382 0.479835 0.479835 0.519382" mass="0.074425" diaginertia="0.00022654 0.000224576 7.40351e-06"/>
				<joint name="pitch_front_joint" range="-0.93556 0.94249"/>
				<geom mesh="pitch_front_link" class="visual" material="off_white"/>
			</body>
		</body>
	</worldbody>


	<!-- Exclude Contacts -->
	<contact>
		<exclude body1="main_insertion_link" body2="tool_roll_link"/>
		<exclude body1="tool_roll_link" body2="tool_pitch_link"/>
		<exclude body1="tool_pitch_link" body2="tool_gripper1_link"/>
		<exclude body1="tool_pitch_link" body2="tool_gripper2_link"/>
		<exclude body1="tool_gripper1_link" body2="tool_gripper2_link"/>
	</contact>

	<equality>
		<joint joint1="jaw" joint2="tool_gripper1_joint" polycoef="0 -1 0 0 0"/>
		<joint joint1="outer_pitch" joint2="pitch_bottom_joint" polycoef="0 -1 0 0 0"/>
		<joint joint1="outer_pitch" joint2="pitch_end_joint" polycoef="0 1 0 0 0"/>
		<joint joint1="outer_pitch" joint2="pitch_top_joint" polycoef="0 -1 0 0 0"/>
		<joint joint1="outer_pitch" joint2="pitch_front_joint" polycoef="0 1 0 0 0"/>
	</equality>

	<actuator>
		<position class="psm_cf" name="actuator1" joint="outer_yaw" ctrlrange="-1.605 1.5994"/>
		<position class="psm_cf" name="actuator2" joint="outer_pitch" ctrlrange="-0.935560 0.94249"/>
		<position class="psm_cf" name="actuator5" joint="main_insertion" ctrlrange="0 0.24"/>
		<position class="cf_tool" name="actuator6" joint="tool_roll" ctrlrange="-3.14158 3.14158"/>
		<position class="cf_tool" name="actuator7" joint="tool_pitch" ctrlrange="-1.5708 1.5708"/>
		<position class="cf_tool" name="actuator8" joint="tool_yaw" ctrlrange="-1.5708 1.5708"/>
		<position class="cf_tool" name="actuator9" joint="jaw" ctrlrange="0 0.523599"/>
	</actuator>

	<keyframe>
		<key name="home" qpos="0 0 0 0 0.10 0 0 0 0 0 0 0" ctrl="0 0 0.10 0 0 0 0"/>
	</keyframe>

</mujoco>
