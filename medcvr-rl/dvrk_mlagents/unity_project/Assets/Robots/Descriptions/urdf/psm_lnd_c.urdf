<!-- This file contains the description of the dVRK PSM robot with LND tool. -->
<!-- Contains primitive collisions for all joints for full collision.         -->

<?xml version="1.0" encoding="utf-8"?>

<!-- ================= -->
<!--       Joints      -->
<!-- ================= -->
<robot name="psm_lnd">
	<mujoco>
		<compiler discardvisual="false" meshdir="../meshes/obj/" balanceinertia="true"/>
	</mujoco>

	<!-- Joint: world-base -->
	<joint name="world_base_joint" type="fixed">
		<parent link="world"/>
		<child link="base_link"/>
		<origin rpy="0 0 0" xyz="0 0.4864 0.1524"/>
	</joint>

	<joint name="outer_yaw" type="revolute">
		<origin rpy="1.570796 -1.570796 0" xyz="0 0 0"/>
		<parent link="base_link"/>
		<child link="yaw_link"/>
		<axis xyz="0 0 1"/>
		<limit effort="1000" lower="-1.605" upper="1.5994" velocity="10"/>
	</joint>

	<joint name="outer_pitch" type="revolute">
		<origin rpy="-1.570796 -0.29073 0" xyz="0 0 0.516"/>
		<parent link="yaw_link"/>
		<child link="pitch_back_link"/>
		<axis xyz="0 0 1"/>
		<limit effort="1000" lower="-0.93556" upper="0.94249" velocity="10"/>
	</joint>

	<joint name="pitch_bottom_joint" type="revolute">
		<origin rpy="0 0 1.8615" xyz="0.15 0 0"/>
		<parent link="pitch_back_link"/>
		<child link="pitch_bottom_link"/>
		<axis xyz="0 0 1"/>
		<limit effort="1000" lower="-0.94249" upper="0.93556" velocity="10"/>
		<mimic joint="outer_pitch" multiplier="-1" offset="0"/>
	</joint>

	<joint name="pitch_end_joint" type="revolute">
		<origin rpy="0 0 0" xyz="0.516 0 0"/>
		<parent link="pitch_bottom_link"/>
		<child link="pitch_end_link"/>
		<axis xyz="0 0 1"/>
		<limit effort="1000" lower="-0.93556" upper="0.94249" velocity="10"/>
		<mimic joint="outer_pitch" multiplier="1" offset="0"/>
	</joint>

	<joint name="pitch_top_joint" type="revolute">
		<origin rpy="0 0 1.8615" xyz="0.18366 0.014121 0"/>
		<parent link="pitch_back_link"/>
		<child link="pitch_top_link"/>
		<axis xyz="0 0 1"/>
		<limit effort="1000" lower="-0.94249" upper="0.93556" velocity="10"/>
		<mimic joint="outer_pitch" multiplier="-1" offset="0"/>
	</joint>

	<joint name="pitch_front_joint" type="revolute">
		<origin rpy="-1.570796 -0.29073 0" xyz="0 0 0.42"/>
		<parent link="yaw_link"/>
		<child link="pitch_front_link"/>
		<axis xyz="0 0 1"/>
		<mimic joint="outer_pitch" multiplier="1" offset="0"/>
		<limit effort="1000" lower="-0.93556" upper="0.94249" velocity="10"/>
	</joint>

	<!--Virtual tool mount link-->
	<!--will be at l_rcc = 0.4318-->
	<joint name="tool_mount_joint" type="fixed">
		<origin rpy="1.570796 1.570796 3.14159" xyz="0.043 -0.28809 0"/>
		<parent link="pitch_end_link"/>
		<child link="tool_mount_link"/>
	</joint>

	<joint name="outer_insertion" type="prismatic">
		<origin rpy="0 0 0" xyz="0 0 0"/>
		<parent link="tool_mount_link"/>
		<child link="main_insertion_link"/>
		<axis xyz="0 0 1"/>
		<limit effort="1000" lower="0" upper="0.24" velocity="1"/>
	</joint>

	<joint name="outer_roll" type="revolute">
		<origin rpy="0 0 -1.5708" xyz="0 0 0.4162"/>
		<parent link="main_insertion_link"/>
		<child link="tool_roll_link"/>
		<axis xyz="0 0 1"/>
		<limit effort="1000" lower="-3.14159" upper="3.14159" velocity="10"/>
	</joint>

	<joint name="outer_wrist_pitch" type="revolute">
		<origin rpy="1.5708 -1.5708 0" xyz="0 0 0"/>
		<parent link="tool_roll_link"/>
		<child link="tool_pitch_link"/>
		<axis xyz="0 0 1"/>
		<limit effort="1000" lower="-1.5708" upper="1.5708" velocity="10"/>
	</joint>

	<joint name="outer_wrist_yaw" type="revolute">
		<origin rpy="-1.5708 1.5708 0" xyz="0.0091 0 0"/>
		<parent link="tool_pitch_link"/>
		<child link="tool_yaw_link"/>
		<axis xyz="0 0 1"/>
		<limit effort="1000" lower="-1.5708" upper="1.5708" velocity="10"/>
	</joint>

	<joint name="tool_gripper1_joint" type="revolute">
		<origin rpy="0 0 0" xyz="0 0 0"/>
		<parent link="tool_yaw_link"/>
		<child link="tool_gripper1_link"/>
		<axis xyz="0 0 1"/>
		<mimic joint="jaw" multiplier="-1" offset="0"/>
		<limit effort="0" lower="-1" upper="0" velocity="0"/>
	</joint>

	<joint name="jaw" type="revolute">
		<origin rpy="0 0 0" xyz="0 0 0"/>
		<parent link="tool_yaw_link"/>
		<child link="tool_gripper2_link"/>
		<axis xyz="0 0 1"/>
		<limit effort="0" lower="0" upper="1" velocity="0"/>
	</joint>

	<joint name="tool_tip_joint" type="fixed">
		<origin rpy="1.5708 1.5708 0" xyz="0 -0.0102 0"/>
		<parent link="tool_yaw_link"/>
		<child link="tool_tip"/>
	</joint>

	<!-- ================= -->
	<!--       Links       -->
	<!-- ================= -->
	<!-- World -->
	<link name="world"/>

	<link name="base_link">
		<inertial>
			<origin rpy="0 0 0" xyz="0 -0.17016 -0.085607"/>
			<mass value="2.0161"/>
			<inertia ixx="0.03342853" ixy="0.0094252" ixz="-0.00334012" iyy="0" iyz="0" izz="0.02897334"/>
		</inertial>
		<visual>
			<origin rpy="0 0 0" xyz="0 -0.4864 0"/>
			<geometry>
				<mesh filename="package://meshes/obj/base_link.obj"/>
			</geometry>
			<material name="">
				<color rgba="0.89804 0.91765 0.92941 1"/>
			</material>
		</visual>
		<collision name="base_link_collision">
			<origin rpy="0 0 0" xyz="0 -0.57240 -0.04270"/>
			<geometry>
				<box size="0.13381 0.40680 0.21940"/>
			</geometry>
		</collision>
	</link>

