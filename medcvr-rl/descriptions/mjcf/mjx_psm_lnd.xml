<!-- This file contains the description of the dVRK PSM robot with LND tool.-->

<mujoco model="psm_lnd">

  <compiler angle="radian" meshdir="../assets/obj/" autolimits="true"/>

  <default>
    <default class="psm_lnd">
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom type="mesh" group="3" contype="0" conaffinity="0"/>
        <default class="gripper_collision">
          <geom condim="3" solimp="2 1 0.01" solref="0.01 1" friction="1 0.005 0.0001"/>
        </default>
        <default class="sphere_collision">
          <geom type="sphere" size="0.0006" rgba="1 0 0 1"/>
        </default>
        <default class="primitive_collision">
          <geom contype="0" conaffinity="1" rgba="1 0 0 0.5" group="4"/>
        </default>
      </default>
    </default>
  </default>

  <asset>
    <material name="off_white" rgba="0.89804 0.91765 0.92941 1"/>
    <material name="black" rgba="0.3 0.3 0.3 1"/>
    <material name="silver" rgba="0.79608 0.82353 0.93725 1"/>

    <!-- Collision meshes -->
    <mesh file="lnd_roll_link_collision_0.obj"/>
    <mesh file="lnd_roll_link_collision_1.obj"/>
    <mesh file="lnd_roll_link_collision_2.obj"/>
    <mesh file="lnd_pitch_link_collision_0.obj"/>
    <mesh file="lnd_pitch_link_collision_1.obj"/>
    <mesh file="lnd_pitch_link_collision_2.obj"/>
    <mesh file="lnd_gripper_link_collision_0.obj"/>
    <mesh file="lnd_gripper_link_collision_1.obj"/>
    <mesh file="tool_main_insertion_link_collision_0.obj"/>
    <mesh file="tool_main_insertion_link_collision_1.obj"/>
    <!-- Visual meshes -->
    <mesh file="base_link.obj"/>
    <mesh file="yaw_link.obj"/>
    <mesh file="pitch_back_link.obj"/>
    <mesh file="pitch_bottom_link.obj"/>
    <mesh file="pitch_end_link.obj"/>
    <mesh file="pitch_top_link.obj"/>
    <mesh file="pitch_front_link.obj"/>
    <mesh file="tool_main_insertion_link.obj"/>
    <mesh file="lnd_roll_link.obj"/>
    <mesh file="lnd_pitch_link.obj"/>
    <mesh file="lnd_yaw_link.obj"/>
    <mesh file="lnd_gripper_link.obj"/>
  </asset>

  <worldbody>
    <body name="base_link" pos="0 -0.0886 0.1524">
      <geom mesh="base_link" pos="0 -0.4864 0" class="visual" material="off_white"/>

      <body name="yaw_link" quat="0.5 0.5 -0.5 0.5">
        <inertial pos="-0.038769 0 0.041596" quat="0.999476 -0.0323563 -0.000353998 0.000808658" mass="1.4705" diaginertia="0.0181432 0.015746 0.0082178"/>
        <joint name="outer_yaw" class="outer_yaw"/>
        <geom mesh="yaw_link" pos="0 0 0.4864" class="visual" material="off_white"/>

        <body name="pitch_back_link" pos="0 0 0.516" quat="0.699649 -0.699649 -0.102427 -0.102427">
          <inertial pos="-0.011651 -0.036241 0" quat="0.526057 0.535871 0.461387 0.47247" mass="0.98494" diaginertia="0.00571089 0.00564713 0.00196294"/>
          <joint name="outer_pitch" class="outer_pitch"/>
          <geom mesh="pitch_back_link" class="visual" material="off_white"/>

          <body name="pitch_bottom_link" pos="0.15 0 0" quat="0.597233 0 0 0.802068">
            <inertial pos="0.25683 -0.010348 0" quat="0.493171 0.49203 0.507846 0.506736" mass="0.44569" diaginertia="0.0112804 0.0111024 0.000450444"/>
            <joint name="pitch_bottom_joint" class="pitch_bottom_joint"/>
            <geom mesh="pitch_bottom_link" class="visual" material="off_white"/>

            <body name="pitch_end_link" pos="0.516 0 0">
              <inertial pos="-0.0019293 -0.13613 0" quat="0.707004 0.707004 -0.0120644 -0.0120619" mass="0.355" diaginertia="0.0238961 0.0238961 0.0238961"/>
              <joint name="pitch_end_joint" class="pitch_end_joint"/>
              <geom mesh="pitch_end_link" class="visual" material="off_white"/>

              <body name="main_insertion_link" pos="0.043 -0.28809 0" quat="0.5 -0.499999 0.500001 0.499999">
                <inertial pos="0.0040563 -0.00010934 0.0098616" quat="0.923879 0.382683 -0.00072506 -0.00030033" mass="0.22491" diaginertia="0.004 0.004 0.004"/>
                <joint name="main_insertion" class="main_insertion"/>
                <geom mesh="tool_main_insertion_link" quat="0.707105 0 0 0.707108" class="visual" material="black"/>
                <geom mesh="tool_main_insertion_link_collision_0" quat="0.707105 0 0 0.707108" class="collision"/>
                <geom mesh="tool_main_insertion_link_collision_1" quat="0.707105 0 0 0.707108" class="collision"/>

                <body name="tool_roll_link" pos="0 0 0.4162" quat="0.707105 0 0 -0.707108">
                  <inertial pos="0 0 -0.0058234" quat="0.820473 0.339851 -0.17592 0.424708" mass="0.00033225" diaginertia="0.00102 0.00099 0.00099"/>
                  <joint name="tool_roll" class="tool_roll"/>
                  <geom mesh="lnd_roll_link" class="visual" material="silver"/>
                  <geom mesh="lnd_roll_link_collision_0" class="collision"/>
                  <geom mesh="lnd_roll_link_collision_1" class="collision"/>
                  <geom mesh="lnd_roll_link_collision_2" class="collision"/>

                  <body name="tool_pitch_link" quat="0.499998 0.5 -0.5 0.500002">
                    <inertial pos="0.0035763 0 0" quat="0.820473 0.339851 -0.17592 0.424708" mass="0.00025784" diaginertia="0.00102 0.00099 0.00099"/>
                    <joint name="tool_pitch" class="tool_pitch"/>
                    <geom mesh="lnd_pitch_link" class="visual" material="silver"/>
                    <geom mesh="lnd_pitch_link_collision_0" class="collision"/>
                    <geom mesh="lnd_pitch_link_collision_1" class="collision"/>
                    <geom mesh="lnd_pitch_link_collision_2" class="collision"/>
                    <geom type="capsule" size="0.0034" fromto="0 0 0 0.008 0 0" class="primitive_collision"/>


                    <body name="tool_yaw_link" pos="0.0091 0 0" quat="0.499998 -0.5 0.5 0.500002">
                      <inertial pos="0 0 0" quat="0.820473 0.339851 -0.17592 0.424708" mass="0.012491" diaginertia="0.00102 0.00099 0.00099"/>
                      <joint name="tool_yaw" class="tool_yaw"/>
                      <geom mesh="lnd_yaw_link" class="visual" material="silver"/>

                      <body name="tool_gripper1_link">
                        <inertial pos="0.00019605 0.001435 -0.00088478" quat="0.820473 0.339851 -0.17592 0.424708" mass="0.010491" diaginertia="0.00102 0.00099 0.00099"/>
                        <joint name="tool_gripper1_joint" class="tool_gripper1_joint"/>
                        <geom mesh="lnd_gripper_link" class="visual" material="silver"/>
                        <geom mesh="lnd_gripper_link_collision_0" class="collision"/>
                        <geom mesh="lnd_gripper_link_collision_1" class="collision"/>
						            <geom type="capsule" size="0.0012" fromto="-0.001 -0.001 0 -0.0003 -0.0087 0" class="primitive_collision"/>
                      </body>
                      <body name="tool_gripper2_link">
                        <inertial pos="-0.00019605 0.001435 0.00088478" quat="0.820473 0.339851 -0.17592 0.424708" mass="0.010491" diaginertia="0.00102 0.00099 0.00099"/>
                        <joint name="jaw" class="jaw"/>
                        <geom mesh="lnd_gripper_link" quat="-3.67321e-06 0 1 0" class="visual" material="silver"/>
                        <geom mesh="lnd_gripper_link_collision_0" quat="-3.67321e-06 0 1 0" class="collision"/>
                        <geom mesh="lnd_gripper_link_collision_1" quat="-3.67321e-06 0 1 0" class="collision"/>
                        <geom type="capsule" size="0.0012" fromto="0.001 -0.001 0 0.0003 -0.0087 0" class="primitive_collision"/>
                        </body>
                      <site name="tool_tip" size="0.00001" pos="0 -0.0102 0" quat="0.499998 -0.5 0.5 0.500002" rgba="1 0 0 1" group="1"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>

          <body name="pitch_top_link" pos="0.18366 0.014121 0" quat="0.597233 0 0 0.802068">
            <inertial pos="0.31246 -0.00056566 0" quat="0.500628 0.500628 0.499371 0.499371" mass="0.17841" diaginertia="0.00463463 0.00449516 0.000149862"/>
            <joint name="pitch_top_joint" class="pitch_top_joint"/>
            <geom mesh="pitch_top_link" class="visual" material="off_white"/>
          </body>
        </body>
        <body name="pitch_front_link" pos="0 0 0.42" quat="0.699649 -0.699649 -0.102427 -0.102427">
          <inertial pos="0.096269 0 0.047551" quat="0.519382 0.479835 0.479835 0.519382" mass="0.074425" diaginertia="0.00022654 0.000224576 7.40351e-06"/>
          <joint name="pitch_front_joint" class="pitch_front_joint"/>
          <geom mesh="pitch_front_link" class="visual" material="off_white"/>
        </body>
      </body>
    </body>
  </worldbody>


  <!-- Exclude Contacts -->
  <contact>
    <exclude body1="main_insertion_link" body2="tool_roll_link"/>
    <exclude body1="tool_roll_link" body2="tool_pitch_link"/>
    <exclude body1="tool_pitch_link" body2="tool_gripper1_link"/>
    <exclude body1="tool_pitch_link" body2="tool_gripper2_link"/>
    <exclude body1="tool_gripper1_link" body2="tool_gripper2_link"/>
  </contact>

  <include file="../mjcf/psm_actuators.xml"/>

  <actuator>
    <position name="jaw" joint="jaw"/>
  </actuator>
</mujoco>
