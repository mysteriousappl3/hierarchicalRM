# Copy this file to benchmarking/.env and fill in only the providers you use.

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages

# Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenAI-compatible local servers: vLLM, LM Studio, Ollama OpenAI mode, etc.
LOCAL_OPENAI_API_KEY=
LOCAL_OPENAI_BASE_URL=http://localhost:8000/v1/chat/completions

# Optional defaults used by hanoi_benchmark.py.
DEFAULT_PROVIDER=mock
DEFAULT_MODEL=mock-hanoi
DEFAULT_REASONING_EFFORT=


