# Copy this file to benchmarking/.env and fill in only the providers you use.

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages

# Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenAI-compatible local servers: vLLM, LM Studio, Ollama OpenAI mode, etc.
LOCAL_OPENAI_API_KEY=
# vLLM/LM Studio default:
LOCAL_OPENAI_BASE_URL=http://localhost:8000/v1/chat/completions
# Ollama default (run `ollama serve` then `ollama pull <model>`):
# LOCAL_OPENAI_BASE_URL=http://localhost:11434/v1/chat/completions
# Set true only when the local server implements OpenAI strict json_schema output.
LOCAL_STRUCTURED_OUTPUTS=false
# Some Ollama models/versions default to a small context window unless num_ctx
# is set explicitly. Only used by provider=local/openai-compatible.
# WARNING (confirmed on Ollama 0.32.15): this per-request override is NOT
# reliably honored via the OpenAI-compatible endpoint for models without a
# baked-in num_ctx (e.g. HF-imported GGUFs). Check with:
#   curl http://localhost:11434/api/ps
# If context_length doesn't match what you set, bake it in instead: write a
# Modelfile with `FROM <model>` and `PARAMETER num_ctx 40960`, then:
#   ollama create <new-tag> -f Modelfile
# and point DEFAULT_MODEL at <new-tag>.
LOCAL_NUM_CTX=8192
# Live logging: set LIVE_LOG=true to append one JSON line per completed model
# call (stage, sizes, usage, output preview) to results/live_log.jsonl as the
# run progresses -- useful for `tail -f`-ing a long local run instead of
# waiting for it to finish before you see anything. Override the path with
# LIVE_LOG_PATH=<file>.
LIVE_LOG=false
LIVE_LOG_PATH=
# OpenAI-compat servers hardcode temperature=0 unless overridden here (or via --temperature).
LOCAL_TEMPERATURE=
# Ollama-only, best-effort: true/false/low/medium/high. Support varies by
# Ollama/model version; verify empirically rather than assuming it works.
LOCAL_THINK=
# Optional JSON object of additional Ollama `options` fields (top_p, top_k,
# repeat_penalty, etc). Merged with LOCAL_NUM_CTX/LOCAL_THINK; keys here win
# on conflict. Example: {"top_p": 0.9, "repeat_penalty": 1.1}
LOCAL_MODEL_OPTIONS=
MODEL_REQUEST_TIMEOUT_SECONDS=1800

# Optional defaults used by hanoi_benchmark.py.
DEFAULT_PROVIDER=mock
DEFAULT_MODEL=mock-hanoi
DEFAULT_REASONING_EFFORT=
